# CI 测试镜像：构建 vmess + 跑功能测试
# 用法: docker build -f tests/Dockerfile.ci -t vmess-ci . && docker run --rm vmess-ci
# 说明: 通过 docker build 上下文把代码拷入镜像，规避"嵌套 docker 挂载宿主路径"问题
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential g++-12 cmake liburing-dev libssl-dev python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

CMD ["bash", "tests/run_ci.sh"]
